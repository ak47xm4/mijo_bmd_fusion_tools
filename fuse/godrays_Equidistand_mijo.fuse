-- Godrays mijo
-- run in CPU
--
-- Nuke Godrays 的演算法：對每個輸出 pixel，沿著「單位變換 → 完整變換」
-- 做 steps 次雙線性取樣，再平均（或逐通道取 max）。From/To Color 在 gamma
-- 空間裡插值，乘在每一個 sample 上。
--
-- Projection：
--   Rectilinear     — 現有 image-space 仿射（translate / rotate / scale / skew）。
--   Equidistant 180 — 球面測地線 smear 朝向 Light（Mode B）。
--     Center = Light（vanish），unproject 用 Fisheye Centre + Circle Radius。
--     Translate = screen-space XY 測地線（camera-fixed）：光軸上等同像素位移，
--       離軸沿固定 3D 軸 Rodrigues，不是直線、也不摺進 Light。
--     Scale 沿 dest↔Light 測地線做逆縮放（u = 1 / lerp(1, scale, t)）。
--     Rotate 繞鏡頭 +Z（φ）。Skew 忽略。
--     光軸上 Light + 只拉 Scale → 經線，跟 Rectilinear 幾乎一樣直。
--
-- 與 Nuke 的差異（刻意的）：
--   1. Center / Translate 用 Fusion 的 0–1 正規化座標，不是 pixel。
--   2. translate / rotate / scale / skew 會合成，不像 Nuke 那樣互不相容。
--   3. 正角度 = 逆時針（Fusion 慣例；Nuke 是負值順時針）。
--   4. Mask / Mix 用 Fusion 內建的 Effect Mask 與 Blend，不重做 Nuke 那組。
--
-- MultiProcessPixels 規則與 noise_3D_mijo.fuse 相同：
--   processPixel 只看得到 userData 的 key。helper 惰性建到 worker 全域
--   （GRY_gen）；長存 closure 絕不讀全域，會變的值一律當參數傳入。
--   threadinitfunc 幫每個 worker 配一個 Pixel，給 SamplePixelB 用。

FuRegisterClass("Godrays_Equidistand_mijo", CT_Tool, {
    REGS_Name = "Godrays Equidistand mijo",
    REGS_Category = "mijo",
    REGS_OpIconString = "GRy",
    REGS_OpDescription = "Nuke-style godrays; Equidistant 180 geodesic smear",
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
    REG_SupportsDoD = true,
})

function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    InProjection = self:AddInput("Projection", "Projection", {
        LINKID_DataType = "Number",
        INPID_InputControl = "MultiButtonControl",
        INP_Integer = true,
        INP_Default = 0.0,
        INP_DoNotifyChanged = true,
        MBTNC_StretchToFit = true,
        { MBTNC_AddButton = "Rectilinear",     MBTNCD_ButtonWidth = 0.5 },
        { MBTNC_AddButton = "Equidistant 180", MBTNCD_ButtonWidth = 0.5 },
        INPS_StatusText =
        "Rectilinear: image-plane affine. Equidistant 180: geodesic smear toward Light on the hemisphere. Skew is ignored in Equidistant.",
    })

    InCenter = self:AddInput("Center", "Center", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.5,
        INP_DefaultY = 0.5,
        INPS_StatusText =
        "Rectilinear: affine pivot. Equidistant 180: Light (3D vanish). Unprojected through Fisheye Centre.",
    })

    InFisheyeCentre = self:AddInput("Fisheye Centre", "FisheyeCentre", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "CrosshairControl",
        INP_DefaultX = 0.5,
        INP_DefaultY = 0.5,
        IC_Visible = false,
        INPS_StatusText = "Optical axis for unproject / project. Hidden in Rectilinear. Default frame centre.",
    })

    InCircleRadius = self:AddInput("Circle Radius", "CircleRadius", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.05,
        INP_MaxScale = 1.5,
        INP_Default = 0.5,
        IC_Visible = false,
        INPS_StatusText =
        "0.5 = inscribed 180° circle (half min-dimension). >0.5 full-frame / cropped. <0.5 letterboxed circle.",
    })

    -- Relative 0–1 offset. No CrosshairControl: default (0,0) would sit on the origin.
    InTranslate = self:AddInput("Translate", "Translate", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INP_DefaultX = 0.0,
        INP_DefaultY = 0.0,
        INPS_StatusText =
        "Screen-space XY smear. Rectilinear: straight pixels. Equidistant: same XY as a geodesic (pixels at the optical centre); not added to Light.",
    })

    InRotate = self:AddInput("Rotate", "Rotate", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ScrewControl",
        INPID_PreviewControl = "AngleControl",
        INP_MinScale = -360.0,
        INP_MaxScale = 360.0,
        INP_Default = 0.0,
        ACP_Center = InCenter,
        INPS_StatusText =
        "Degrees, CCW (Fusion). Rectilinear: around Center. Equidistant: around the lens axis (+Z / Fisheye Centre).",
    })

    InScale = self:AddInput("Scale", "Scale", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        INP_Default = 1.0,
        INPS_StatusText =
        "<1 smears toward Light / Center. Equidistant walks that geodesic (equal angle), not a straight line.",
    })

    InSkew = self:AddInput("Skew", "Skew", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = -2.0,
        INP_MaxScale = 2.0,
        INP_Default = 0.0,
        INPS_StatusText = "Horizontal skew. Ignored when Projection is Equidistant 180 (no spherical analogue in v1).",
    })

    InFrom_R = self:AddInput("Red", "FromRed", {
        ICS_Name = "From Color",
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        CLRC_ShowWheel = false,
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 0,
    })
    InFrom_G = self:AddInput("Green", "FromGreen", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 1,
    })
    InFrom_B = self:AddInput("Blue", "FromBlue", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 2,
    })

    InTo_R = self:AddInput("Red", "ToRed", {
        ICS_Name = "To Color",
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        CLRC_ShowWheel = false,
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 2,
        IC_ControlID = 0,
    })
    InTo_G = self:AddInput("Green", "ToGreen", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 2,
        IC_ControlID = 1,
    })
    InTo_B = self:AddInput("Blue", "ToBlue", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 4.0,
        ICD_Center = 1.0,
        IC_ControlGroup = 2,
        IC_ControlID = 2,
    })

    InGamma = self:AddInput("Gamma", "Gamma", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.1,
        INP_MaxScale = 4.0,
        INP_Default = 1.0,
    })

    InSteps = self:AddInput("Steps", "Steps", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Integer = true,
        INP_MinScale = 1.0,
        INP_MaxScale = 64.0,
        INP_Default = 16.0,
    })

    InMax = self:AddInput("Max", "Max", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Integer = true,
        INP_Default = 0.0,
    })
end

function NotifyChanged(inp, param, time)
    if inp == InProjection and param and type(param.Value) == "number" then
        local fe = param.Value > 0.5
        InFisheyeCentre:SetAttrs({ IC_Visible = fe })
        InCircleRadius:SetAttrs({ IC_Visible = fe })
        InSkew:SetAttrs({ IC_Visible = not fe })
    end
end

-- IMG_DataWindow / IMG_ValidWindow 只接受 FuRectInt。fuse sandbox 沒有
-- FuRectInt() 建構子，所以只用 Image / Request 已經給的 rect：
--   img.DataWindow、GetInputDoD():Intersect()、GetRoI().ValidWindow。
-- GetRoI() 本身是 ImageDomain，不能直接丟進 Image{}。
-- Equidistant 測地線不是直線：不要縮成 rectilinear AABB，維持 input DoD ∩ RoI。
-- 圓外 pixel 在 processPixel 裡 skip（黑），不做圓形 DoD。
local function outputWindows(req, img)
    local datawnd = img.DataWindow
    local dod = req:GetInputDoD(InImage)
    if dod then
        datawnd = dod:Intersect(datawnd)
    end

    local roi = req:GetRoI()
    local validwnd = nil
    if roi then
        datawnd = roi:Intersect(datawnd)
        validwnd = roi.ValidWindow
    end
    return datawnd, validwnd
end

function PrecalcProcess(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    local datawnd = outputWindows(req, img)
    local out = Image({
        IMG_Like = img,
        IMG_NoData = true,
        IMG_DataWindow = datawnd,
        IMG_Depth = IMG_Depth_Float,
    })
    if not out then
        return
    end
    OutImage:Set(req, out)
end

function Process(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    local proj = InProjection:GetValue(req).Value
    local fisheye = proj > 0.5
    local center = InCenter:GetValue(req)
    local lens = InFisheyeCentre:GetValue(req)
    local circleRadius = InCircleRadius:GetValue(req).Value
    local translate = InTranslate:GetValue(req)
    local rotate = InRotate:GetValue(req).Value
    local scale = InScale:GetValue(req).Value
    local skew = InSkew:GetValue(req).Value
    local fromR = InFrom_R:GetValue(req).Value
    local fromG = InFrom_G:GetValue(req).Value
    local fromB = InFrom_B:GetValue(req).Value
    local toR = InTo_R:GetValue(req).Value
    local toG = InTo_G:GetValue(req).Value
    local toB = InTo_B:GetValue(req).Value
    local gamma = InGamma:GetValue(req).Value
    local steps = InSteps:GetValue(req).Value
    local useMax = InMax:GetValue(req).Value > 0.5

    if steps < 1 then
        steps = 1
    elseif steps > 64 then
        steps = 64
    end
    steps = steps - steps % 1

    local width = img.Width
    local height = img.Height
    local cx = center.X * width
    local cy = center.Y * height
    local tx = translate.X * width
    local ty = translate.Y * height
    local cxL = lens.X * width
    local cyL = lens.Y * height
    if circleRadius < 0.05 then
        circleRadius = 0.05
    end
    local thetaMax = 3.14159265358979323846 * 0.5
    local R = circleRadius * math.min(width, height)
    if R < 1.0 then
        R = 1.0
    end
    local f = R / thetaMax

    -- Light = Center only (allow past the image circle so a corner vanish
    -- still has a 3D direction; samples with θ>θ_max are skipped).
    -- Translate is a separate camera-fixed geodesic, not folded into Light.
    local lightX = cx
    local lightY = cy
    local lx, ly, lz = 0.0, 0.0, 1.0
    local lightOk = 0.0
    do
        local dx, dy = lightX - cxL, lightY - cyL
        local r = math.sqrt(dx * dx + dy * dy)
        local theta = r / f
        if theta < 3.14159265358979323846 - 1.0e-6 then
            local phi = math.atan2(dy, dx)
            local st, ct = math.sin(theta), math.cos(theta)
            lx = st * math.cos(phi)
            ly = st * math.sin(phi)
            lz = ct
            lightOk = 1.0
        end
    end

    local datawnd, validwnd = outputWindows(req, img)

    local DWleft = datawnd.left
    local DWbottom = datawnd.bottom
    local DWwidth = datawnd.right - DWleft
    local DWheight = datawnd.top - DWbottom

    if DWwidth <= 0 or DWheight <= 0 then
        local out = Image({
            IMG_Like = img,
            IMG_NoData = true,
            IMG_DataWindow = datawnd,
            IMG_Depth = IMG_Depth_Float,
        })
        if out then
            OutImage:Set(req, out)
        end
        return
    end

    -- Identity + white tint: no smear, just copy into the output window.
    -- Equidistant Translate is a geodesic smear (counts here). Skew is ignored.
    local identity = rotate * rotate < 1e-20
        and (scale - 1.0) * (scale - 1.0) < 1e-20
        and tx * tx + ty * ty < 1e-20
        and (fromR - 1.0) * (fromR - 1.0) < 1e-20
        and (fromG - 1.0) * (fromG - 1.0) < 1e-20
        and (fromB - 1.0) * (fromB - 1.0) < 1e-20
        and (toR - 1.0) * (toR - 1.0) < 1e-20
        and (toG - 1.0) * (toG - 1.0) < 1e-20
        and (toB - 1.0) * (toB - 1.0) < 1e-20
    if not fisheye then
        identity = identity and skew * skew < 1e-20
    end

    if identity then
        local out = Image({
            IMG_Like = img,
            IMG_DataWindow = datawnd,
            IMG_ValidWindow = validwnd,
            IMG_Depth = IMG_Depth_Float,
            IMG_CopyChannels = true,
        })
        if not out then
            return
        end
        img:Crop(out, {})
        OutImage:Set(req, out)
        return
    end

    local out = Image({
        IMG_Like = img,
        IMG_DataWindow = datawnd,
        IMG_ValidWindow = validwnd,
        IMG_Depth = IMG_Depth_Float,
        IMG_NoData = true,
    })
    if not out then
        return
    end

    -- ------------------------------------------------------------------------
    -- Pixel function
    --
    -- MultiProcessPixels 在 worker context 執行：模組層的函式與 Process 的 local
    -- 都看不到，只有 userData 的 key（加上 threadinitfunc 寫進環境的 Samp）
    -- 會被注入成全域。GRY_gen 建到 worker 全域，之後的 pixel 直接重用。
    -- ------------------------------------------------------------------------
    local function processPixel(x, y, p)
        local gen = GRY_gen

        if not gen then
            local sin = math.sin
            local cos = math.cos
            local sqrt = math.sqrt
            local atan2 = math.atan2
            local acos = math.acos
            local PI = 3.14159265358979323846
            local DEG2RAD = PI / 180.0
            local SCALE_EPS = 1.0e-6

            -- 會變動的值一律走參數，不讀全域 —— 這個 closure 會活過多次
            -- Process 呼叫，讀全域有機會綁到過期的環境表。
            --
            -- Rectilinear forward at t (source s → dest d):
            --   v = s - C
            --   skew:   x += (skew * t) * y
            --   scale:  lerp(1, scale, t)
            --   rotate: CCW by rotate * t degrees
            --   d = v + C + Translate * t
            -- Inverse is that sequence undone.
            --
            -- Equidistant 180: inverse camera-fixed Translate (Rodrigues about
            -- A = normalize(cross(+Z, T)), angle t*|T|/f), then inverse-scale
            -- along dest↔Light, then rotate about +Z. Skew is ignored.
            -- Sample skipped if θ > θ_max.

            local function fe_unproject(x, y, cx, cy, f, thetaMax)
                local dx, dy = x - cx, y - cy
                local r = sqrt(dx * dx + dy * dy)
                local theta = r / f
                if theta > thetaMax then
                    return nil
                end
                local phi = atan2(dy, dx)
                local st, ct = sin(theta), cos(theta)
                return st * cos(phi), st * sin(phi), ct
            end

            local function fe_project(dx, dy, dz, cx, cy, f, thetaMax)
                local theta = atan2(sqrt(dx * dx + dy * dy), dz)
                if theta > thetaMax or dz < 0.0 then
                    return nil
                end
                local phi = atan2(dy, dx)
                local r = f * theta
                return cx + r * cos(phi), cy + r * sin(phi)
            end

            local function fe_rodrigues(vx, vy, vz, kx, ky, kz, a)
                local ca, sa = cos(a), sin(a)
                local dot = kx * vx + ky * vy + kz * vz
                local cxp = ky * vz - kz * vy
                local cyp = kz * vx - kx * vz
                local czp = kx * vy - ky * vx
                local om = 1.0 - ca
                return vx * ca + cxp * sa + kx * dot * om,
                    vy * ca + cyp * sa + ky * dot * om,
                    vz * ca + czp * sa + kz * dot * om
            end

            local function fe_slerp(ax, ay, az, bx, by, bz, t)
                local d = ax * bx + ay * by + az * bz
                if d > 1.0 then
                    d = 1.0
                elseif d < -1.0 then
                    d = -1.0
                end
                if d < -0.999 then
                    return nil
                end
                local omega = acos(d)
                if omega < 1.0e-6 then
                    return ax, ay, az
                end
                local so = sin(omega)
                local s = sin((1.0 - t) * omega) / so
                local e = sin(t * omega) / so
                return s * ax + e * bx, s * ay + e * by, s * az + e * bz
            end

            local function clampScaleT(st)
                if st >= 0.0 then
                    if st < SCALE_EPS then
                        return SCALE_EPS
                    end
                elseif st > -SCALE_EPS then
                    return -SCALE_EPS
                end
                return st
            end

            GRY_gen = function(px, py, src, samp, cx, cy, tx, ty, rot, sc, sk, n, doMax,
                               fr, fg, fb, tr, tg, tb, g,
                               proj, cxL, cyL, f, thetaMax, lx, ly, lz, lightOk)
                local accR, accG, accB, accA
                if doMax then
                    accR, accG, accB, accA = -1.0e37, -1.0e37, -1.0e37, -1.0e37
                else
                    accR, accG, accB, accA = 0.0, 0.0, 0.0, 0.0
                end

                if g < SCALE_EPS then
                    g = SCALE_EPS
                end
                local useGamma = (g > 1.000001 or g < 0.999999)
                local invG, frg, fgg, fbg, trg, tgg, tbg
                if useGamma then
                    invG = 1.0 / g
                    frg, fgg, fbg = fr ^ g, fg ^ g, fb ^ g
                    trg, tgg, tbg = tr ^ g, tg ^ g, tb ^ g
                end

                local denom = n - 1
                if denom < 1 then
                    denom = 1
                end

                local fisheye = proj > 0.5
                local any = false

                -- Dest on the sphere + camera-fixed Translate axis (constant
                -- screen XY). A = normalize(cross(+Z, T)) so +angle at the
                -- optical axis walks toward (tx, ty). Inverse uses -t*|T|/f.
                -- destOk (not destX) — destX is 0 on the optical axis.
                local destX, destY, destZ, destOk
                local tax, tay, tlen, hasT
                if fisheye then
                    destX, destY, destZ = fe_unproject(px, py, cxL, cyL, f, thetaMax)
                    destOk = destX ~= nil
                    tlen = sqrt(tx * tx + ty * ty)
                    hasT = tlen > 1.0e-8
                    if hasT then
                        tax, tay = -ty / tlen, tx / tlen
                    end
                end

                for i = 0, n - 1 do
                    local t = 0.0
                    if n > 1 then
                        t = i / denom
                    end

                    local sx, sy, ok
                    if not fisheye then
                        -- v = d - C - T*t
                        local vx = px - cx - tx * t
                        local vy = py - cy - ty * t

                        -- inverse rotate (CCW by -rot*t)
                        local ang = -rot * t * DEG2RAD
                        local ca, sa = cos(ang), sin(ang)
                        local rx = vx * ca - vy * sa
                        local ry = vx * sa + vy * ca

                        -- inverse scale; keep the interpolant off zero
                        local st = clampScaleT(1.0 + t * (sc - 1.0))
                        rx = rx / st
                        ry = ry / st

                        -- inverse horizontal skew: x -= (skew*t) * y
                        rx = rx - (sk * t) * ry

                        sx, sy, ok = rx + cx, ry + cy, true
                    elseif destOk then
                        local dx, dy, dz = destX, destY, destZ
                        local live = true
                        if hasT then
                            dx, dy, dz = fe_rodrigues(
                                dx, dy, dz, tax, tay, 0.0, -(tlen / f) * t
                            )
                            if dz < 0.0 then
                                live = false
                            end
                        end

                        if live then
                            local st = clampScaleT(1.0 + t * (sc - 1.0))
                            local sx3, sy3, sz3
                            if lightOk > 0.5 then
                                local dtl = dx * lx + dy * ly + dz * lz
                                if dtl > 1.0 then
                                    dtl = 1.0
                                elseif dtl < -1.0 then
                                    dtl = -1.0
                                end
                                if dtl < -0.999 then
                                    -- antipodes: slerp unstable, skip
                                elseif dtl > 0.999999 then
                                    -- dest ≈ Light: identity on the sphere
                                    sx3, sy3, sz3 = dx, dy, dz
                                else
                                    -- Inverse of scale-toward-Light: u=1 at dest,
                                    -- u>1 past dest (scale<1), u<1 toward Light.
                                    local u = 1.0 / st
                                    local omega = acos(dtl)
                                    if (u - 1.0) * omega > PI or (1.0 - u) * omega > PI then
                                        -- would wrap past the antipode
                                    else
                                        sx3, sy3, sz3 = fe_slerp(lx, ly, lz, dx, dy, dz, u)
                                    end
                                end
                            else
                                -- Light outside the sphere: scale θ about the lens axis.
                                local xy = sqrt(dx * dx + dy * dy)
                                local theta = atan2(xy, dz)
                                local theta2 = theta / st
                                if theta2 < 0.0 then
                                    theta2 = 0.0
                                end
                                local phi = atan2(dy, dx)
                                local s2, c2 = sin(theta2), cos(theta2)
                                sx3 = s2 * cos(phi)
                                sy3 = s2 * sin(phi)
                                sz3 = c2
                            end

                            if sx3 ~= nil then
                                if rot * rot > 1.0e-20 then
                                    sx3, sy3, sz3 = fe_rodrigues(
                                        sx3, sy3, sz3, 0.0, 0.0, 1.0, -rot * t * DEG2RAD
                                    )
                                end
                                sx, sy = fe_project(sx3, sy3, sz3, cxL, cyL, f, thetaMax)
                                if sx ~= nil then
                                    ok = true
                                end
                            end
                        end
                    end

                    if ok then
                        src:SamplePixelB(sx, sy, samp)

                        local cr, cg, cb
                        if useGamma then
                            cr = (frg + t * (trg - frg)) ^ invG
                            cg = (fgg + t * (tgg - fgg)) ^ invG
                            cb = (fbg + t * (tbg - fbg)) ^ invG
                        else
                            cr = fr + t * (tr - fr)
                            cg = fg + t * (tg - fg)
                            cb = fb + t * (tb - fb)
                        end

                        local sr = samp.R * cr
                        local sg = samp.G * cg
                        local sb = samp.B * cb
                        local sa = samp.A * (cr + cg + cb) * (1.0 / 3.0)

                        any = true
                        if doMax then
                            if sr > accR then accR = sr end
                            if sg > accG then accG = sg end
                            if sb > accB then accB = sb end
                            if sa > accA then accA = sa end
                        else
                            accR = accR + sr
                            accG = accG + sg
                            accB = accB + sb
                            accA = accA + sa
                        end
                    end
                end

                if not any then
                    return 0.0, 0.0, 0.0, 0.0
                end

                if not doMax then
                    local invN = 1.0 / n
                    accR = accR * invN
                    accG = accG * invN
                    accB = accB * invN
                    accA = accA * invN
                end

                return accR, accG, accB, accA
            end

            gen = GRY_gen
        end

        local r, g, b, a = gen(
            x + 0.5, y + 0.5,
            Src, Samp,
            Cx, Cy, Tx, Ty,
            Rot, Scale, Skew, Steps, UseMax,
            FromR, FromG, FromB, ToR, ToG, ToB, Gamma,
            Proj, CxL, CyL, F, ThetaMax, Lx, Ly, Lz, LightOk
        )
        p.R = r
        p.G = g
        p.B = b
        p.A = a
        return p
    end

    local userData = {
        Src = img,
        Cx = cx,
        Cy = cy,
        Tx = tx,
        Ty = ty,
        Rot = rotate,
        Scale = scale,
        Skew = skew,
        Steps = steps,
        UseMax = useMax,
        FromR = fromR,
        FromG = fromG,
        FromB = fromB,
        ToR = toR,
        ToG = toG,
        ToB = toB,
        Gamma = gamma,
        Proj = proj,
        CxL = cxL,
        CyL = cyL,
        F = f,
        ThetaMax = thetaMax,
        Lx = lx,
        Ly = ly,
        Lz = lz,
        LightOk = lightOk,
    }

    out:MultiProcessPixels(
        function()
            Samp = Pixel()
        end,
        userData,
        DWleft, DWbottom, DWwidth, DWheight,
        img,
        processPixel
    )

    OutImage:Set(req, out)
end

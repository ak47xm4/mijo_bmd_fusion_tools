FuRegisterClass("Noise3D_mijo", CT_Tool, {
    REGS_Name = "Noise 3D mijo",
    REGS_Category = "mijo",
    REGS_OpIconString = "N3D",
    REGS_OpDescription = "Convert RGB channels to XYZ position and generate grayscale noise",
    REG_OpNoMask = true,
    REG_OpNoBlendCtrls = true,
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
})

function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Noise algorithm selection
    InNoiseType = self:AddInput("Noise Type", "NoiseType", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Perlin Noise" },
        { CCS_AddString = "Simplex Noise" },
        { CCS_AddString = "Value Noise" },
        { CCS_AddString = "Worley Noise" },
        { CCS_AddString = "FBM (Fractal Brownian Motion)" },
        INP_MaxScale = 4.0,
        INP_MinScale = 0.0,
    })

    -- Output mode selection
    InOutputMode = self:AddInput("Output Mode", "OutputMode", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Grayscale" },
        { CCS_AddString = "RGB" },
        INP_MaxScale = 1.0,
        INP_MinScale = 0.0,
    })

    -- Scale/Size parameter
    InScale = self:AddInput("Scale", "Scale", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    -- Scale X/Y/Z parameters
    InScaleX = self:AddInput("Scale X", "ScaleX", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InScaleY = self:AddInput("Scale Y", "ScaleY", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InScaleZ = self:AddInput("Scale Z", "ScaleZ", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    -- Octaves for FBM
    InOctaves = self:AddInput("Octaves", "Octaves", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 1.0,
        INP_MaxScale = 8.0,
        INP_Default = 4.0,
        INP_Integer = true,
    })

    -- Lacunarity for FBM
    InLacunarity = self:AddInput("Lacunarity", "Lacunarity", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 1.0,
        INP_MaxScale = 4.0,
        INP_Default = 2.0,
    })

    -- Persistence for FBM
    InPersistence = self:AddInput("Persistence", "Persistence", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.5,
    })

    -- Offset for position
    InOffsetX = self:AddInput("Offset X", "OffsetX", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    InOffsetY = self:AddInput("Offset Y", "OffsetY", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    InOffsetZ = self:AddInput("Offset Z", "OffsetZ", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    -- Seethe (animation intensity)
    InSeethe = self:AddInput("Seethe", "Seethe", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    -- Seethe Rate (animation speed)
    InSeetheRate = self:AddInput("Seethe Rate", "SeetheRate", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    -- Output range
    InMinValue = self:AddInput("Min Value", "MinValue", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    InMaxValue = self:AddInput("Max Value", "MaxValue", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 1.0,
    })
end

-- Optimized hash function - faster alternative using fractional part
-- Reduced sin/cos calls for better performance
function hash(n)
    -- Fast hash using fractional part of multiplication
    -- Single sin call instead of multiple sin/cos
    local n_scaled = n * 12.9898
    local h = math.sin(n_scaled) * 43758.5453
    -- Extract fractional part and normalize to [-1, 1]
    local result = h - math.floor(h)
    return result * 2.0 - 1.0
end

function hash3(x, y, z)
    -- Use float coordinates directly with different multipliers
    local n = x * 12.9898 + y * 78.233 + z * 43758.5453
    return hash(n)
end

-- Dot product for gradient
function dot(gx, gy, gz, x, y, z)
    return gx * x + gy * y + gz * z
end

-- Fade function for smooth interpolation
function fade(t)
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
end

function lerp(a, b, t)
    return a + t * (b - a)
end

-- Optimized gradient function - reduced trigonometric calls
function grad3(hash_val, x, y, z)
    -- Simplified gradient using single angle calculation
    -- Normalize hash to [0, 1] range
    local h_norm = (hash_val + 1.0) * 0.5
    -- Single angle calculation instead of two
    local angle = h_norm * 6.28318530718 -- 2*PI
    local cos_a = math.cos(angle)
    local sin_a = math.sin(angle)
    -- Combine x, y, z with rotated coordinates
    return cos_a * x + sin_a * y + (cos_a * 0.707106781 + sin_a * 0.707106781) * z
end

-- Perlin Noise 3D
function perlinNoise3D(x, y, z)
    -- Use float coordinates directly without integer grid
    -- Get integer parts for corner positions
    local X = math.floor(x)
    local Y = math.floor(y)
    local Z = math.floor(z)

    -- Get fractional parts for interpolation
    local fx = x - X
    local fy = y - Y
    local fz = z - Z

    -- Calculate neighbor coordinates (continuous float space)
    local X1 = X + 1.0
    local Y1 = Y + 1.0
    local Z1 = Z + 1.0

    local u = fade(fx)
    local v = fade(fy)
    local w = fade(fz)

    -- Use float coordinates for hash (no modulo wrapping)
    local h000 = hash3(X, Y, Z)
    local h001 = hash3(X, Y, Z1)
    local h010 = hash3(X, Y1, Z)
    local h011 = hash3(X, Y1, Z1)
    local h100 = hash3(X1, Y, Z)
    local h101 = hash3(X1, Y, Z1)
    local h110 = hash3(X1, Y1, Z)
    local h111 = hash3(X1, Y1, Z1)

    local AAA = grad3(h000, fx, fy, fz)
    local ABA = grad3(h001, fx, fy, fz - 1.0)
    local AAB = grad3(h010, fx, fy - 1.0, fz)
    local ABB = grad3(h011, fx, fy - 1.0, fz - 1.0)
    local BAA = grad3(h100, fx - 1.0, fy, fz)
    local BBA = grad3(h101, fx - 1.0, fy, fz - 1.0)
    local BAB = grad3(h110, fx - 1.0, fy - 1.0, fz)
    local BBB = grad3(h111, fx - 1.0, fy - 1.0, fz - 1.0)

    return lerp(
        lerp(
            lerp(AAA, BAA, u),
            lerp(ABA, BBA, u),
            w
        ),
        lerp(
            lerp(AAB, BAB, u),
            lerp(ABB, BBB, u),
            w
        ),
        v
    )
end

-- Simplified Simplex Noise (using Perlin-like implementation)
function simplexNoise3D(x, y, z)
    -- Simplified version - can be expanded with proper Simplex implementation
    return perlinNoise3D(x * 0.707106781, y * 0.707106781, z * 0.707106781)
end

-- Value Noise 3D
function valueNoise3D(x, y, z)
    -- Use float coordinates directly without integer grid
    -- Get integer parts for corner positions
    local X = math.floor(x)
    local Y = math.floor(y)
    local Z = math.floor(z)

    -- Get fractional parts for interpolation
    local fx = x - X
    local fy = y - Y
    local fz = z - Z

    -- Calculate neighbor coordinates (continuous float space)
    local X1 = X + 1.0
    local Y1 = Y + 1.0
    local Z1 = Z + 1.0

    local u = fade(fx)
    local v = fade(fy)
    local w = fade(fz)

    -- Use float coordinates for hash (no modulo wrapping)
    local a = hash3(X, Y, Z)
    local b = hash3(X1, Y, Z)
    local c = hash3(X, Y1, Z)
    local d = hash3(X1, Y1, Z)
    local e = hash3(X, Y, Z1)
    local f = hash3(X1, Y, Z1)
    local g = hash3(X, Y1, Z1)
    local h = hash3(X1, Y1, Z1)

    return lerp(
        lerp(
            lerp(a, b, u),
            lerp(c, d, u),
            v
        ),
        lerp(
            lerp(e, f, u),
            lerp(g, h, u),
            v
        ),
        w
    )
end

-- Optimized Worley Noise - uses distance squared to avoid sqrt
function worleyNoise3D(x, y, z)
    -- Use float cell coordinates
    local cellX = math.floor(x)
    local cellY = math.floor(y)
    local cellZ = math.floor(z)

    local minDistSq = math.huge

    for k = -1, 1 do
        for j = -1, 1 do
            for i = -1, 1 do
                -- Use float coordinates directly
                local neighborX = cellX + i
                local neighborY = cellY + j
                local neighborZ = cellZ + k

                -- Generate feature point using float hash
                local pointX = neighborX + hash3(neighborX, neighborY, neighborZ) * 0.5 + 0.25
                local pointY = neighborY + hash3(neighborX + 1.0, neighborY, neighborZ) * 0.5 + 0.25
                local pointZ = neighborZ + hash3(neighborX, neighborY + 1.0, neighborZ) * 0.5 + 0.25

                local dx = x - pointX
                local dy = y - pointY
                local dz = z - pointZ
                local distSq = dx * dx + dy * dy + dz * dz

                if distSq < minDistSq then
                    minDistSq = distSq
                end
            end
        end
    end

    -- Only calculate sqrt once at the end
    return math.sqrt(minDistSq)
end

-- FBM (Fractal Brownian Motion)
function fbmNoise3D(x, y, z, octaves, lacunarity, persistence, noiseFunc)
    local value = 0.0
    local amplitude = 1.0
    local frequency = 1.0
    local maxValue = 0.0

    for i = 0, octaves - 1 do
        value = value + noiseFunc(x * frequency, y * frequency, z * frequency) * amplitude
        maxValue = maxValue + amplitude
        amplitude = amplitude * persistence
        frequency = frequency * lacunarity
    end

    return value / maxValue
end

-- Main noise function dispatcher
function getNoiseValue(x, y, z, noiseType, scale, octaves, lacunarity, persistence)
    x = x * scale
    y = y * scale
    z = z * scale

    if noiseType == 0 then
        -- Perlin Noise
        return perlinNoise3D(x, y, z)
    elseif noiseType == 1 then
        -- Simplex Noise
        return simplexNoise3D(x, y, z)
    elseif noiseType == 2 then
        -- Value Noise
        return valueNoise3D(x, y, z)
    elseif noiseType == 3 then
        -- Worley Noise
        return worleyNoise3D(x, y, z)
    elseif noiseType == 4 then
        -- FBM
        return fbmNoise3D(x, y, z, octaves, lacunarity, persistence, perlinNoise3D)
    else
        return perlinNoise3D(x, y, z)
    end
end

function Process(req)
    local img = InImage:GetValue(req)

    if not img then
        return nil
    end

    -- Check input image depth - this is the *original* upstream image
    -- IMG_Depth_Float = 0, IMG_Depth_8 = 1, IMG_Depth_16 = 2
    local inputDepth = img.Depth
    local noiseType = InNoiseType:GetValue(req).Value
    local outputMode = InOutputMode:GetValue(req).Value
    local scale = InScale:GetValue(req).Value
    local scaleX = InScaleX:GetValue(req).Value
    local scaleY = InScaleY:GetValue(req).Value
    local scaleZ = InScaleZ:GetValue(req).Value
    local octaves = InOctaves:GetValue(req).Value
    local lacunarity = InLacunarity:GetValue(req).Value
    local persistence = InPersistence:GetValue(req).Value
    local offsetX = InOffsetX:GetValue(req).Value
    local offsetY = InOffsetY:GetValue(req).Value
    local offsetZ = InOffsetZ:GetValue(req).Value
    local seethe = InSeethe:GetValue(req).Value
    local seetheRate = InSeetheRate:GetValue(req).Value
    local minValue = InMinValue:GetValue(req).Value
    local maxValue = InMaxValue:GetValue(req).Value

    -- Get current time for animation (only when SeetheRate > 0 to optimize cache)
    -- When SeetheRate = 0, we don't use time, so Fusion can cache the result
    local currentTime = 0.0
    if seetheRate > 0.0 then
        currentTime = req.Time or 0.0
    end

    -- Get DataWindow and RoI
    local dod = req:GetInputDoD(InImage)
    local roi = req:GetRoI()
    local datawnd = dod:Intersect(img.DataWindow)
    if roi then
        datawnd = roi:Intersect(datawnd)
    end

    -- Create a temporary image to copy source data, always as 32‑bit float.
    -- All further processing (noise) is done on this float image.
    local img_temp = Image({
        IMG_Like = img,
        IMG_DataWindow = datawnd,
        IMG_ValidWindow = roi and roi.ValidWindow,
        IMG_Depth = IMG_Depth_Float,
        IMG_CopyChannels = true, -- Copy channels from source to ensure correct values
    })
    -- Copy source image data to temporary image (Fusion will convert to float if needed)
    img:Crop(img_temp, {})

    local out = Image({
        IMG_Like = img_temp,
        IMG_DataWindow = datawnd,
        IMG_ValidWindow = roi and roi.ValidWindow,
        IMG_Depth = IMG_Depth_Float, -- force 32‑bit float output
        IMG_NoData = true,           -- Don't copy channels, we'll write our own values
    })

    -- Get image dimensions from DataWindow
    local DWleft = datawnd.left
    local DWbottom = datawnd.bottom
    local DWright = datawnd.right
    local DWtop = datawnd.top
    local width = DWright - DWleft
    local height = DWtop - DWbottom

    -- Process pixels using MultiProcessPixels
    -- Define function BEFORE creating userData, similar to Grade.fuse
    -- Optimized pixel processing function
    local function processPixel(x, y, p)
        -- Extract RGB as XYZ position from input pixel
        local posX = p.R + OffsetX
        local posY = p.G + OffsetY
        local posZ = p.B + OffsetZ

        -- Generate noise value based on NoiseType
        -- Optimized inline functions for better performance
        local noiseValue = 0.0

        -- Inline helper functions (optimized)
        local function localFade(t)
            local t2 = t * t
            local t3 = t2 * t
            return t3 * (t * (t * 6.0 - 15.0) + 10.0)
        end

        local function localLerp(a, b, t)
            return a + t * (b - a)
        end

        -- Optimized hash - single sin call
        local function localHash(n)
            local h = math.sin(n * 12.9898) * 43758.5453
            local result = h - math.floor(h)
            return result * 2.0 - 1.0
        end

        local function localHash3(x, y, z)
            return localHash(x * 12.9898 + y * 78.233 + z * 43758.5453)
        end

        -- Optimized gradient - reduced trig calls
        local function localGrad3(hash_val, x, y, z)
            local h_norm = (hash_val + 1.0) * 0.5
            local angle = h_norm * 6.28318530718 -- 2*PI
            local cos_a = math.cos(angle)
            local sin_a = math.sin(angle)
            return cos_a * x + sin_a * y + (cos_a * 0.707106781 + sin_a * 0.707106781) * z
        end

        -- Inline Perlin Noise 3D（使用浮點座標）
        local function localPerlinNoise3D(x, y, z)
            -- Use float coordinates directly without integer grid
            -- Get integer parts for corner positions
            local X = math.floor(x)
            local Y = math.floor(y)
            local Z = math.floor(z)

            -- Get fractional parts for interpolation
            local fx = x - X
            local fy = y - Y
            local fz = z - Z

            -- Calculate neighbor coordinates (continuous float space)
            local X1 = X + 1.0
            local Y1 = Y + 1.0
            local Z1 = Z + 1.0

            local u = localFade(fx)
            local v = localFade(fy)
            local w = localFade(fz)

            -- Use float coordinates for hash (no modulo wrapping)
            local h000 = localHash3(X, Y, Z)
            local h001 = localHash3(X, Y, Z1)
            local h010 = localHash3(X, Y1, Z)
            local h011 = localHash3(X, Y1, Z1)
            local h100 = localHash3(X1, Y, Z)
            local h101 = localHash3(X1, Y, Z1)
            local h110 = localHash3(X1, Y1, Z)
            local h111 = localHash3(X1, Y1, Z1)

            local AAA = localGrad3(h000, fx, fy, fz)
            local ABA = localGrad3(h001, fx, fy, fz - 1.0)
            local AAB = localGrad3(h010, fx, fy - 1.0, fz)
            local ABB = localGrad3(h011, fx, fy - 1.0, fz - 1.0)
            local BAA = localGrad3(h100, fx - 1.0, fy, fz)
            local BBA = localGrad3(h101, fx - 1.0, fy, fz - 1.0)
            local BAB = localGrad3(h110, fx - 1.0, fy - 1.0, fz)
            local BBB = localGrad3(h111, fx - 1.0, fy - 1.0, fz - 1.0)

            return localLerp(
                localLerp(
                    localLerp(AAA, BAA, u),
                    localLerp(ABA, BBA, u),
                    w
                ),
                localLerp(
                    localLerp(AAB, BAB, u),
                    localLerp(ABB, BBB, u),
                    w
                ),
                v
            )
        end

        -- Inline Value Noise 3D
        local function localValueNoise3D(x, y, z)
            -- Use float coordinates directly without integer grid
            -- Get integer parts for corner positions
            local X = math.floor(x)
            local Y = math.floor(y)
            local Z = math.floor(z)

            -- Get fractional parts for interpolation
            local fx = x - X
            local fy = y - Y
            local fz = z - Z

            -- Calculate neighbor coordinates (continuous float space)
            local X1 = X + 1.0
            local Y1 = Y + 1.0
            local Z1 = Z + 1.0

            local u = localFade(fx)
            local v = localFade(fy)
            local w = localFade(fz)

            -- Use float coordinates for hash (no modulo wrapping)
            local a = localHash3(X, Y, Z)
            local b = localHash3(X1, Y, Z)
            local c = localHash3(X, Y1, Z)
            local d = localHash3(X1, Y1, Z)
            local e = localHash3(X, Y, Z1)
            local f = localHash3(X1, Y, Z1)
            local g = localHash3(X, Y1, Z1)
            local h = localHash3(X1, Y1, Z1)

            return localLerp(
                localLerp(
                    localLerp(a, b, u),
                    localLerp(c, d, u),
                    v
                ),
                localLerp(
                    localLerp(e, f, u),
                    localLerp(g, h, u),
                    v
                ),
                w
            )
        end

        -- Calculate time offset for animation (only used for noise types that support animation)
        local timeOffset = CurrentTime * SeetheRate + Seethe

        -- Helper function to generate noise value with channel offset for RGB mode
        local function generateNoise(channelOffsetX, channelOffsetY, channelOffsetZ)
            local noiseVal = 0.0
            local finalPosX = posX + channelOffsetX
            local finalPosY = posY + channelOffsetY
            local finalPosZ = posZ + channelOffsetZ + timeOffset

            -- Optimized noise type selection with precomputed scales
            if NoiseType == 0 then
                -- Perlin Noise (supports animation)
                noiseVal = localPerlinNoise3D(finalPosX * Scale * ScaleX, finalPosY * Scale * ScaleY,
                    finalPosZ * Scale * ScaleZ)
            elseif NoiseType == 1 then
                -- Simplex Noise (simplified, using Perlin approximation) (supports animation)
                local s = 0.707106781 -- sqrt(0.5) for Simplex
                noiseVal = localPerlinNoise3D(finalPosX * Scale * ScaleX * s, finalPosY * Scale * ScaleY * s,
                    finalPosZ * Scale * ScaleZ * s)
            elseif NoiseType == 2 then
                -- Value Noise (supports animation)
                noiseVal = localValueNoise3D(finalPosX * Scale * ScaleX, finalPosY * Scale * ScaleY,
                    finalPosZ * Scale * ScaleZ)
            elseif NoiseType == 3 then
                -- Worley Noise (cellular) - optimized with distance squared
                local sx = finalPosX * Scale * ScaleX
                local sy = finalPosY * Scale * ScaleY
                local sz = finalPosZ * Scale * ScaleZ
                local cellX = math.floor(sx)
                local cellY = math.floor(sy)
                local cellZ = math.floor(sz)
                local minDistSq = math.huge
                for k = -1, 1 do
                    for j = -1, 1 do
                        for i = -1, 1 do
                            local neighborX = cellX + i
                            local neighborY = cellY + j
                            local neighborZ = cellZ + k
                            local pointX = neighborX + localHash3(neighborX, neighborY, neighborZ) * 0.5 + 0.25
                            local pointY = neighborY + localHash3(neighborX + 1.0, neighborY, neighborZ) * 0.5 + 0.25
                            local pointZ = neighborZ + localHash3(neighborX, neighborY + 1.0, neighborZ) * 0.5 + 0.25
                            local dx = sx - pointX
                            local dy = sy - pointY
                            local dz = sz - pointZ
                            local distSq = dx * dx + dy * dy + dz * dz
                            if distSq < minDistSq then
                                minDistSq = distSq
                            end
                        end
                    end
                end
                -- Only calculate sqrt once at the end
                noiseVal = math.sqrt(minDistSq) * 2.0 - 1.0
            elseif NoiseType == 4 then
                -- FBM (Fractal Brownian Motion) - optimized loop (supports animation)
                local value = 0.0
                local amplitude = 1.0
                local frequency = 1.0
                local maxValue = 0.0
                local posX_scaled = finalPosX * Scale * ScaleX
                local posY_scaled = finalPosY * Scale * ScaleY
                local posZ_scaled = finalPosZ * Scale * ScaleZ
                for i = 0, Octaves - 1 do
                    value = value +
                        localPerlinNoise3D(posX_scaled * frequency, posY_scaled * frequency, posZ_scaled * frequency) *
                        amplitude
                    maxValue = maxValue + amplitude
                    amplitude = amplitude * Persistence
                    frequency = frequency * Lacunarity
                end
                noiseVal = value / maxValue
            else
                -- Default to Perlin (supports animation)
                noiseVal = localPerlinNoise3D(finalPosX * Scale * ScaleX, finalPosY * Scale * ScaleY,
                    finalPosZ * Scale * ScaleZ)
            end

            -- Normalize from [-1, 1] to [0, 1] if needed, then remap to [minValue, maxValue]
            noiseVal = (noiseVal + 1.0) * 0.5
            noiseVal = localLerp(MinValue, MaxValue, noiseVal)

            -- Clamp to valid range (optimized single-line clamp)
            noiseVal = noiseVal < 0.0 and 0.0 or (noiseVal > 1.0 and 1.0 or noiseVal)

            return noiseVal
        end

        -- Generate noise based on output mode
        if OutputMode == 1 then
            -- RGB mode: generate different noise for each channel using offsets
            -- Use different offsets to create variation between channels
            local offsetR = 100.0 -- Offset for Red channel
            local offsetG = 200.0 -- Offset for Green channel
            local offsetB = 300.0 -- Offset for Blue channel
            p.R = generateNoise(offsetR, offsetR * 0.5, offsetR * 0.25)
            p.G = generateNoise(offsetG, offsetG * 0.5, offsetG * 0.25)
            p.B = generateNoise(offsetB, offsetB * 0.5, offsetB * 0.25)
        else
            -- Grayscale mode: same noise for all channels
            local noiseValue = generateNoise(0.0, 0.0, 0.0)
            p.R = noiseValue
            p.G = noiseValue
            p.B = noiseValue
        end
        -- Alpha is preserved automatically by MultiProcessPixels

        return p
    end

    -- Prepare userData - keys will be injected as globals in processPixel function
    local userData = {
        OffsetX = offsetX,
        OffsetY = offsetY,
        OffsetZ = offsetZ,
        NoiseType = noiseType,
        OutputMode = outputMode,
        Scale = scale,
        ScaleX = scaleX,
        ScaleY = scaleY,
        ScaleZ = scaleZ,
        Seethe = seethe,
        SeetheRate = seetheRate,
        CurrentTime = currentTime,
        Octaves = octaves,
        Lacunarity = lacunarity,
        Persistence = persistence,
        MinValue = minValue,
        MaxValue = maxValue,
    }

    -- Use MultiProcessPixels to process all pixels (automatically multi-threaded by Fusion)
    out:MultiProcessPixels(nil, userData, DWleft, DWbottom, width, height, img_temp, processPixel)

    OutImage:Set(req, out)
end

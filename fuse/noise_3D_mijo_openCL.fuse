-- Noise 3D mijo
-- OpenCL GPU Accelerated version (Performance Optimized)
-- GPU kernel: zero trigonometry — integer hash + Perlin bit-selection gradient
-- Falls back to CPU (MultiProcessPixels) if OpenCL is unavailable

-- ============================================================================
-- OpenCL Kernel Source — fully trig-free for maximum GPU throughput
-- ============================================================================
clsource = [[

// ---------------------------------------------------------------------------
// Integer hash (zero trig — pure ALU operations)
// ---------------------------------------------------------------------------
uint ihash(uint n) {
    n = (n << 13u) ^ n;
    return n * (n * n * 15731u + 789221u) + 1376312589u;
}

// ---------------------------------------------------------------------------
// Perlin gradient — Ken Perlin's original bit-selection (zero trig)
// ---------------------------------------------------------------------------
float grad3(uint hash_val, float x, float y, float z) {
    uint h = hash_val & 15u;
    float u = h < 8u ? x : y;
    float v = h < 4u ? y : ((h == 12u || h == 14u) ? x : z);
    return ((h & 1u) == 0u ? u : -u) + ((h & 2u) == 0u ? v : -v);
}

// ---------------------------------------------------------------------------
// Smooth interpolation
// ---------------------------------------------------------------------------
float fade(float t) {
    return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f);
}

// ---------------------------------------------------------------------------
// Perlin Noise 3D (optimized — zero trig)
// ---------------------------------------------------------------------------
float perlinNoise3D(float x, float y, float z) {
    int Xi = (int)floor(x);
    int Yi = (int)floor(y);
    int Zi = (int)floor(z);

    float fx = x - floor(x);
    float fy = y - floor(y);
    float fz = z - floor(z);

    float u = fade(fx);
    float v = fade(fy);
    float w = fade(fz);

    // Factored partial hashes: 14 ihash() calls instead of 24
    uint hz0  = ihash((uint)Zi);
    uint hz1  = ihash((uint)(Zi + 1));
    uint hy0z0 = ihash((uint)Yi       + hz0);
    uint hy0z1 = ihash((uint)Yi       + hz1);
    uint hy1z0 = ihash((uint)(Yi + 1) + hz0);
    uint hy1z1 = ihash((uint)(Yi + 1) + hz1);

    uint h000 = ihash((uint)Xi       + hy0z0);
    uint h001 = ihash((uint)Xi       + hy0z1);
    uint h010 = ihash((uint)Xi       + hy1z0);
    uint h011 = ihash((uint)Xi       + hy1z1);
    uint h100 = ihash((uint)(Xi + 1) + hy0z0);
    uint h101 = ihash((uint)(Xi + 1) + hy0z1);
    uint h110 = ihash((uint)(Xi + 1) + hy1z0);
    uint h111 = ihash((uint)(Xi + 1) + hy1z1);

    float g000 = grad3(h000, fx,      fy,      fz);
    float g001 = grad3(h001, fx,      fy,      fz-1.0f);
    float g010 = grad3(h010, fx,      fy-1.0f, fz);
    float g011 = grad3(h011, fx,      fy-1.0f, fz-1.0f);
    float g100 = grad3(h100, fx-1.0f, fy,      fz);
    float g101 = grad3(h101, fx-1.0f, fy,      fz-1.0f);
    float g110 = grad3(h110, fx-1.0f, fy-1.0f, fz);
    float g111 = grad3(h111, fx-1.0f, fy-1.0f, fz-1.0f);

    return mix(
        mix(mix(g000, g100, u), mix(g010, g110, u), v),
        mix(mix(g001, g101, u), mix(g011, g111, u), v),
        w
    );
}

// ---------------------------------------------------------------------------
// Value Noise 3D (optimized — zero trig)
// ---------------------------------------------------------------------------
float valueNoise3D(float x, float y, float z) {
    int Xi = (int)floor(x);
    int Yi = (int)floor(y);
    int Zi = (int)floor(z);

    float fx = x - floor(x);
    float fy = y - floor(y);
    float fz = z - floor(z);

    float u = fade(fx);
    float v = fade(fy);
    float w = fade(fz);

    // Factored partial hashes: 14 ihash() calls instead of 24
    uint hz0  = ihash((uint)Zi);
    uint hz1  = ihash((uint)(Zi + 1));
    uint hy0z0 = ihash((uint)Yi       + hz0);
    uint hy0z1 = ihash((uint)Yi       + hz1);
    uint hy1z0 = ihash((uint)(Yi + 1) + hz0);
    uint hy1z1 = ihash((uint)(Yi + 1) + hz1);

    float a = (float)ihash((uint)Xi       + hy0z0) / 2147483648.0f - 1.0f;
    float b = (float)ihash((uint)(Xi + 1) + hy0z0) / 2147483648.0f - 1.0f;
    float c = (float)ihash((uint)Xi       + hy1z0) / 2147483648.0f - 1.0f;
    float d = (float)ihash((uint)(Xi + 1) + hy1z0) / 2147483648.0f - 1.0f;
    float e = (float)ihash((uint)Xi       + hy0z1) / 2147483648.0f - 1.0f;
    float f = (float)ihash((uint)(Xi + 1) + hy0z1) / 2147483648.0f - 1.0f;
    float g = (float)ihash((uint)Xi       + hy1z1) / 2147483648.0f - 1.0f;
    float h = (float)ihash((uint)(Xi + 1) + hy1z1) / 2147483648.0f - 1.0f;

    return mix(
        mix(mix(a, b, u), mix(c, d, u), v),
        mix(mix(e, f, u), mix(g, h, u), v),
        w
    );
}

// ---------------------------------------------------------------------------
// Worley Noise 3D (optimized — zero trig, branchless min, single hash per cell)
// ---------------------------------------------------------------------------
float worleyNoise3D(float x, float y, float z) {
    int cellX = (int)floor(x);
    int cellY = (int)floor(y);
    int cellZ = (int)floor(z);

    float minDistSq = 1e20f;

    // Pre-compute Z hashes (3 unique values, factored out of inner loops)
    // Total: 3 + 9 + 27 = 39 ihash() calls instead of 81
    uint hz[3];
    hz[0] = ihash((uint)(cellZ - 1));
    hz[1] = ihash((uint)cellZ);
    hz[2] = ihash((uint)(cellZ + 1));

    for (int k = -1; k <= 1; k++) {
        int nz = cellZ + k;
        uint hzk = hz[k + 1];
        for (int j = -1; j <= 1; j++) {
            int ny = cellY + j;
            // Factored Y+Z partial hash — reused across all 3 X iterations
            uint hyz = ihash((uint)ny + hzk);
            for (int i = -1; i <= 1; i++) {
                int nx = cellX + i;
                uint h = ihash((uint)nx + hyz);
                float pointX = (float)nx + (float)(h & 0xFFu) / 255.0f * 0.5f + 0.25f;
                float pointY = (float)ny + (float)((h >> 8u) & 0xFFu) / 255.0f * 0.5f + 0.25f;
                float pointZ = (float)nz + (float)((h >> 16u) & 0xFFu) / 255.0f * 0.5f + 0.25f;

                float dx = x - pointX;
                float dy = y - pointY;
                float dz = z - pointZ;
                float distSq = dx * dx + dy * dy + dz * dz;

                minDistSq = min(minDistSq, distSq);
            }
        }
    }

    return native_sqrt(minDistSq) * 2.0f - 1.0f;
}

// ---------------------------------------------------------------------------
// Single-sample noise by type
// ---------------------------------------------------------------------------
inline float sampleNoise(float x, float y, float z, int noiseType) {
    if (noiseType == 0 || noiseType == 4) {
        return perlinNoise3D(x, y, z);
    } else if (noiseType == 1) {
        return perlinNoise3D(x * 0.707106781f, y * 0.707106781f, z * 0.707106781f);
    } else if (noiseType == 2) {
        return valueNoise3D(x, y, z);
    } else if (noiseType == 3) {
        return worleyNoise3D(x, y, z);
    }
    return perlinNoise3D(x, y, z);
}

// ---------------------------------------------------------------------------
// Unified noise generation with FBM octave layering for ALL noise types
// ---------------------------------------------------------------------------
inline float generateNoise(
    float posX, float posY, float posZ,
    float channelOffsetX, float channelOffsetY, float channelOffsetZ,
    float timeOffset,
    int noiseType, float scaleX, float scaleY, float scaleZ,
    int octaves, float lacunarity, float persistence,
    float minValue, float maxValue)
{
    float sx = (posX + channelOffsetX) * scaleX;
    float sy = (posY + channelOffsetY) * scaleY;
    float sz = (posZ + channelOffsetZ + timeOffset) * scaleZ;

    float value = 0.0f;
    float amplitude = 1.0f;
    float frequency = 1.0f;
    float maxAmp = 0.0f;

    for (int i = 0; i < octaves; i++) {
        value += sampleNoise(sx * frequency, sy * frequency, sz * frequency, noiseType) * amplitude;
        maxAmp += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }

    float noiseVal = value / maxAmp;

    // Normalize [-1, 1] -> [0, 1], then remap to [minValue, maxValue]
    noiseVal = mad(noiseVal, 0.5f, 0.5f);
    noiseVal = mix(minValue, maxValue, noiseVal);

    return clamp(noiseVal, 0.0f, 1.0f);
}

// ---------------------------------------------------------------------------
// Main Kernel
// ---------------------------------------------------------------------------
__kernel void Noise3DKernel(
    FuReadImage_t src,
    FuWriteImage_t dst,
    int2 imgsize,
    int4 intParams,
    float4 scaleParams,
    float4 noiseParams,
    float4 offsetParams,
    float4 rangeParams)
{
    int2 ipos = (int2)(get_global_id(1), get_global_id(0));

    if (ipos.x >= imgsize.x || ipos.y >= imgsize.y) return;

    // Unpack vector parameters (reduces Lua SetArg calls from 17 to 8)
    int noiseType     = intParams.x;
    int outputMode    = intParams.y;
    int octaves       = intParams.z;
    float scaleX      = scaleParams.x;
    float scaleY      = scaleParams.y;
    float scaleZ      = scaleParams.z;
    float lacunarity  = noiseParams.x;
    float persistence = noiseParams.y;
    float timeOffset  = noiseParams.z;
    float offsetX     = offsetParams.x;
    float offsetY     = offsetParams.y;
    float offsetZ     = offsetParams.z;
    float minValue    = rangeParams.x;
    float maxValue    = rangeParams.y;

    float4 pixel = FuReadImagef(src, ipos, imgsize);

    float posX = pixel.x + offsetX;
    float posY = pixel.y + offsetY;
    float posZ = pixel.z + offsetZ;

    float4 result;

    if (outputMode == 1) {
        result.x = generateNoise(posX, posY, posZ,
            100.0f, 50.0f, 25.0f, timeOffset,
            noiseType, scaleX, scaleY, scaleZ,
            octaves, lacunarity, persistence, minValue, maxValue);
        result.y = generateNoise(posX, posY, posZ,
            200.0f, 100.0f, 50.0f, timeOffset,
            noiseType, scaleX, scaleY, scaleZ,
            octaves, lacunarity, persistence, minValue, maxValue);
        result.z = generateNoise(posX, posY, posZ,
            300.0f, 150.0f, 75.0f, timeOffset,
            noiseType, scaleX, scaleY, scaleZ,
            octaves, lacunarity, persistence, minValue, maxValue);
    } else {
        float noiseVal = generateNoise(posX, posY, posZ,
            0.0f, 0.0f, 0.0f, timeOffset,
            noiseType, scaleX, scaleY, scaleZ,
            octaves, lacunarity, persistence, minValue, maxValue);
        result.x = noiseVal;
        result.y = noiseVal;
        result.z = noiseVal;
    }

    result.w = pixel.w;

    FuWriteImagef(dst, ipos, imgsize, result);
}

]]

-- ============================================================================
-- Fuse Registration
-- ============================================================================
FuRegisterClass("Noise3D_mijo_CL", CT_Tool, {
    REGS_Name = "Noise 3D mijo CL",
    REGS_Category = "mijo",
    REGS_OpIconString = "N3C",
    REGS_OpDescription = "Convert RGB channels to XYZ position and generate noise (OpenCL GPU accelerated)",
    REG_OpNoMask = true,
    REG_OpNoBlendCtrls = true,
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
})

-- ============================================================================
-- OpenCL Initialization / Cleanup
-- ============================================================================
function OnAddToFlow()
    mgr = OCLManager()
    if mgr then
        local path = string.sub(debug.getinfo(1).source, 2)
        prog = mgr:BuildCachedProgram("Noise3D_mijo_CL", path, clsource)
    end
    _cached_kernel = nil
    _cached_srccl = nil
    _cached_src_img = nil
end

function OnRemoveFromFlow()
    if _cached_srccl then _cached_srccl:Release() end
    _cached_kernel = nil
    _cached_srccl = nil
    _cached_src_img = nil
    prog = nil
    mgr = nil
end

-- ============================================================================
-- UI Controls
-- ============================================================================
function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    InNoiseType = self:AddInput("Noise Type", "NoiseType", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Perlin Noise" },
        { CCS_AddString = "Simplex Noise" },
        { CCS_AddString = "Value Noise" },
        { CCS_AddString = "Worley Noise" },
        { CCS_AddString = "FBM (Fractal Brownian Motion)" },
        INP_MaxScale = 4.0,
        INP_MinScale = 0.0,
    })

    InOutputMode = self:AddInput("Output Mode", "OutputMode", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Grayscale" },
        { CCS_AddString = "RGB" },
        INP_MaxScale = 1.0,
        INP_MinScale = 0.0,
    })

    InProcessMode = self:AddInput("Process Mode", "ProcessMode", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Auto (GPU -> CPU)" },
        { CCS_AddString = "GPU (OpenCL)" },
        { CCS_AddString = "CPU" },
        INP_MaxScale = 2.0,
        INP_MinScale = 0.0,
    })

    InBoundingBox = self:AddInput("Bounding Box", "BoundingBox", {
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "None" },
        { CCS_AddString = "Domain" },
        { CCS_AddString = "Frame" },
        INP_MaxScale = 2.0,
        INP_MinScale = 0.0,
    })

    InScale = self:AddInput("Scale", "Scale", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InScaleX = self:AddInput("Scale X", "ScaleX", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InScaleY = self:AddInput("Scale Y", "ScaleY", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InScaleZ = self:AddInput("Scale Z", "ScaleZ", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 10.0,
        INP_Default = 1.0,
    })

    InOctaves = self:AddInput("Octaves", "Octaves", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 1.0,
        INP_MaxScale = 8.0,
        INP_Default = 4.0,
        INP_Integer = true,
    })

    InLacunarity = self:AddInput("Lacunarity", "Lacunarity", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 1.0,
        INP_MaxScale = 4.0,
        INP_Default = 2.0,
    })

    InPersistence = self:AddInput("Persistence", "Persistence", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.5,
    })

    InOffsetX = self:AddInput("Offset X", "OffsetX", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    InOffsetY = self:AddInput("Offset Y", "OffsetY", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    InOffsetZ = self:AddInput("Offset Z", "OffsetZ", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = -10.0,
        INP_MaxScale = 10.0,
        INP_Default = 0.0,
    })

    InSeethe = self:AddInput("Seethe", "Seethe", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    InSeetheRate = self:AddInput("Seethe Rate", "SeetheRate", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    InMinValue = self:AddInput("Min Value", "MinValue", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 0.0,
    })

    InMaxValue = self:AddInput("Max Value", "MaxValue", {
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default = 1.0,
    })
end

-- ============================================================================
-- Process Function
-- ============================================================================
function Process(req)
    local img = InImage:GetValue(req)

    if not img then
        return nil
    end

    local noiseType = InNoiseType:GetValue(req).Value
    local outputMode = InOutputMode:GetValue(req).Value
    local processMode = InProcessMode:GetValue(req).Value
    local boundingBox = InBoundingBox:GetValue(req).Value
    local scale = InScale:GetValue(req).Value
    local scaleX = InScaleX:GetValue(req).Value
    local scaleY = InScaleY:GetValue(req).Value
    local scaleZ = InScaleZ:GetValue(req).Value
    local octaves = InOctaves:GetValue(req).Value
    local lacunarity = InLacunarity:GetValue(req).Value
    local persistence = InPersistence:GetValue(req).Value
    local offsetX = InOffsetX:GetValue(req).Value
    local offsetY = InOffsetY:GetValue(req).Value
    local offsetZ = InOffsetZ:GetValue(req).Value
    local seethe = InSeethe:GetValue(req).Value
    local seetheRate = InSeetheRate:GetValue(req).Value
    local minValue = InMinValue:GetValue(req).Value
    local maxValue = InMaxValue:GetValue(req).Value

    local currentTime = 0.0
    if seetheRate > 0.0 then
        currentTime = req.Time or 0.0
    end

    local timeOffset = currentTime * seetheRate + seethe

    -- Pre-multiply scale factors (reduces per-pixel multiplications)
    local combinedScaleX = scale * scaleX
    local combinedScaleY = scale * scaleY
    local combinedScaleZ = scale * scaleZ

    -- ========================================================================
    -- OpenCL GPU Path (when processMode is Auto or GPU)
    -- ========================================================================
    local success = false
    local out_ocl = nil

    if prog and processMode ~= 2 then
        -- Cache source OCL image: skip GPU upload when input image hasn't changed.
        -- During slider drag, the upstream output is the SAME Image object,
        -- so this avoids a ~33MB PCIe upload every frame.
        if img ~= _cached_src_img then
            if _cached_srccl then _cached_srccl:Release() end
            _cached_srccl = prog:CreateImage(img, "read")
            _cached_src_img = img
        end
        local srccl = _cached_srccl

        if boundingBox == 2 then
            -- Frame: output DataWindow = full frame
            out_ocl = Image({
                IMG_Width = img.Width,
                IMG_Height = img.Height,
                IMG_XScale = img.XScale,
                IMG_YScale = img.YScale,
                IMG_Depth = IMG_Depth_Float,
                IMG_NoData = true,
            })
        else
            -- None / Domain: inherit input's DataWindow
            out_ocl = Image({
                IMG_Like = img,
                IMG_Depth = IMG_Depth_Float,
                IMG_NoData = true,
            })
        end
        local dstcl = prog:CreateImage(out_ocl, "write")

        if srccl and dstcl then
            -- Cache kernel handle: create once, reuse across frames
            if not _cached_kernel then
                _cached_kernel = prog:CreateKernel("Noise3DKernel")
                if _cached_kernel and _cached_kernel >= 0 then
                    prog:SetWorkgroupSize(16, 16)
                else
                    _cached_kernel = nil
                end
            end
            local kernel = _cached_kernel

            if kernel and kernel >= 0 then
                prog:SetArg(kernel, 0, srccl)
                prog:SetArg(kernel, 1, dstcl)
                prog:SetArgInt(kernel, 2, img.Width, img.Height)
                prog:SetArgInt(kernel, 3, noiseType, outputMode, octaves, 0)
                prog:SetArg(kernel, 4, combinedScaleX, combinedScaleY, combinedScaleZ, 0.0)
                prog:SetArg(kernel, 5, lacunarity, persistence, timeOffset, 0.0)
                prog:SetArg(kernel, 6, offsetX, offsetY, offsetZ, 0.0)
                prog:SetArg(kernel, 7, minValue, maxValue, 0.0, 0.0)

                success = prog:RunKernel(kernel)
            end

            if success then
                success = prog:Download(dstcl, out_ocl)
            end

            -- Only release dstcl; srccl is cached for reuse
            if dstcl then dstcl:Release() end
        end
    end

    if success and out_ocl then
        OutImage:Set(req, out_ocl)
        return
    end

    -- ========================================================================
    -- CPU Fallback (optimized: trig-free gradient, cached math functions)
    -- ========================================================================

    local img_temp, out, DWleft, DWbottom, width, height

    if boundingBox == 2 then
        -- Frame: process full frame, no DoD restriction
        img_temp = Image({
            IMG_Like = img,
            IMG_Depth = IMG_Depth_Float,
            IMG_CopyChannels = true,
        })
        img:Crop(img_temp, {})

        out = Image({
            IMG_Width = img.Width,
            IMG_Height = img.Height,
            IMG_XScale = img.XScale,
            IMG_YScale = img.YScale,
            IMG_Depth = IMG_Depth_Float,
            IMG_NoData = true,
        })

        DWleft = 0
        DWbottom = 0
        width = img.Width
        height = img.Height
    else
        -- None / Domain: respect DoD and input DataWindow
        local dod = req:GetInputDoD(InImage)
        local roi = req:GetRoI()
        local datawnd = dod:Intersect(img.DataWindow)
        if roi then
            datawnd = roi:Intersect(datawnd)
        end

        img_temp = Image({
            IMG_Like = img,
            IMG_DataWindow = datawnd,
            IMG_ValidWindow = roi and roi.ValidWindow,
            IMG_Depth = IMG_Depth_Float,
            IMG_CopyChannels = true,
        })
        img:Crop(img_temp, {})

        out = Image({
            IMG_Like = img_temp,
            IMG_DataWindow = datawnd,
            IMG_ValidWindow = roi and roi.ValidWindow,
            IMG_Depth = IMG_Depth_Float,
            IMG_NoData = true,
        })

        DWleft = datawnd.left
        DWbottom = datawnd.bottom
        width = datawnd.right - datawnd.left
        height = datawnd.top - datawnd.bottom
    end

    local function processPixel(x, y, p)
        -- Cache math functions as locals (avoids global lookup per call)
        local floor = math.floor
        local sin = math.sin
        local sqrt = math.sqrt
        local abs = math.abs
        local huge = math.huge

        local posX = p.R + OffsetX
        local posY = p.G + OffsetY
        local posZ = p.B + OffsetZ

        -- Hash function (single sin per call)
        local function lHash(n)
            local h = sin(n * 12.9898) * 43758.5453
            return (h - floor(h)) * 2.0 - 1.0
        end

        local function lHash3(hx, hy, hz)
            return lHash(hx * 12.9898 + hy * 78.233 + hz * 43758.5453)
        end

        -- Perlin gradient using bit-selection (no trig — replaces sin/cos)
        local function lGrad3(hash_val, gx, gy, gz)
            local h = floor((hash_val + 1.0) * 8.0) % 16
            local u, v
            if h < 8 then u = gx else u = gy end
            if h < 4 then v = gy elseif h == 12 or h == 14 then v = gx else v = gz end
            if h % 2 ~= 0 then u = -u end
            if floor(h * 0.5) % 2 ~= 0 then v = -v end
            return u + v
        end

        local function lFade(t)
            return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
        end

        local function lLerp(a, b, t)
            return a + t * (b - a)
        end

        local function lPerlin(px, py, pz)
            local Xi = floor(px)
            local Yi = floor(py)
            local Zi = floor(pz)
            local fx = px - Xi
            local fy = py - Yi
            local fz = pz - Zi
            local u = lFade(fx)
            local v = lFade(fy)
            local w = lFade(fz)
            local Xi1 = Xi + 1.0
            local Yi1 = Yi + 1.0
            local Zi1 = Zi + 1.0

            local g000 = lGrad3(lHash3(Xi, Yi, Zi),    fx,     fy,     fz)
            local g001 = lGrad3(lHash3(Xi, Yi, Zi1),   fx,     fy,     fz-1.0)
            local g010 = lGrad3(lHash3(Xi, Yi1, Zi),   fx,     fy-1.0, fz)
            local g011 = lGrad3(lHash3(Xi, Yi1, Zi1),  fx,     fy-1.0, fz-1.0)
            local g100 = lGrad3(lHash3(Xi1, Yi, Zi),   fx-1.0, fy,     fz)
            local g101 = lGrad3(lHash3(Xi1, Yi, Zi1),  fx-1.0, fy,     fz-1.0)
            local g110 = lGrad3(lHash3(Xi1, Yi1, Zi),  fx-1.0, fy-1.0, fz)
            local g111 = lGrad3(lHash3(Xi1, Yi1, Zi1), fx-1.0, fy-1.0, fz-1.0)

            return lLerp(
                lLerp(lLerp(g000, g100, u), lLerp(g010, g110, u), v),
                lLerp(lLerp(g001, g101, u), lLerp(g011, g111, u), v),
                w
            )
        end

        local function lValue(vx, vy, vz)
            local Xi = floor(vx)
            local Yi = floor(vy)
            local Zi = floor(vz)
            local fx = vx - Xi
            local fy = vy - Yi
            local fz = vz - Zi
            local u = lFade(fx)
            local v = lFade(fy)
            local w = lFade(fz)
            local Xi1 = Xi + 1.0
            local Yi1 = Yi + 1.0
            local Zi1 = Zi + 1.0

            local a = lHash3(Xi, Yi, Zi)
            local b = lHash3(Xi1, Yi, Zi)
            local c = lHash3(Xi, Yi1, Zi)
            local d = lHash3(Xi1, Yi1, Zi)
            local e = lHash3(Xi, Yi, Zi1)
            local f = lHash3(Xi1, Yi, Zi1)
            local g = lHash3(Xi, Yi1, Zi1)
            local h = lHash3(Xi1, Yi1, Zi1)

            return lLerp(
                lLerp(lLerp(a, b, u), lLerp(c, d, u), v),
                lLerp(lLerp(e, f, u), lLerp(g, h, u), v),
                w
            )
        end

        local function lSample(sx, sy, sz)
            if NoiseType == 0 or NoiseType == 4 then
                return lPerlin(sx, sy, sz)
            elseif NoiseType == 1 then
                return lPerlin(sx * 0.707106781, sy * 0.707106781, sz * 0.707106781)
            elseif NoiseType == 2 then
                return lValue(sx, sy, sz)
            elseif NoiseType == 3 then
                local cX = floor(sx)
                local cY = floor(sy)
                local cZ = floor(sz)
                local minDSq = huge
                for k = -1, 1 do
                    for j = -1, 1 do
                        for i = -1, 1 do
                            local nx = cX + i
                            local ny = cY + j
                            local nz = cZ + k
                            local ptX = nx + lHash3(nx, ny, nz) * 0.5 + 0.25
                            local ptY = ny + lHash3(nx + 1.0, ny, nz) * 0.5 + 0.25
                            local ptZ = nz + lHash3(nx, ny + 1.0, nz) * 0.5 + 0.25
                            local dx = sx - ptX
                            local dy = sy - ptY
                            local dz = sz - ptZ
                            local dSq = dx * dx + dy * dy + dz * dz
                            if dSq < minDSq then minDSq = dSq end
                        end
                    end
                end
                return sqrt(minDSq) * 2.0 - 1.0
            end
            return lPerlin(sx, sy, sz)
        end

        local cpuTimeOffset = CurrentTime * SeetheRate + Seethe

        local function genNoise(coX, coY, coZ)
            local sx = (posX + coX) * CScaleX
            local sy = (posY + coY) * CScaleY
            local sz = (posZ + coZ + cpuTimeOffset) * CScaleZ

            local value = 0.0
            local amplitude = 1.0
            local frequency = 1.0
            local maxAmp = 0.0
            for i = 0, Octaves - 1 do
                value = value + lSample(sx * frequency, sy * frequency, sz * frequency) * amplitude
                maxAmp = maxAmp + amplitude
                amplitude = amplitude * Persistence
                frequency = frequency * Lacunarity
            end

            local nv = value / maxAmp
            nv = (nv + 1.0) * 0.5
            nv = MinValue + (MaxValue - MinValue) * nv
            if nv < 0.0 then nv = 0.0 elseif nv > 1.0 then nv = 1.0 end
            return nv
        end

        if OutputMode == 1 then
            p.R = genNoise(100.0, 50.0, 25.0)
            p.G = genNoise(200.0, 100.0, 50.0)
            p.B = genNoise(300.0, 150.0, 75.0)
        else
            local nv = genNoise(0.0, 0.0, 0.0)
            p.R = nv
            p.G = nv
            p.B = nv
        end

        return p
    end

    local userData = {
        OffsetX = offsetX,
        OffsetY = offsetY,
        OffsetZ = offsetZ,
        NoiseType = noiseType,
        OutputMode = outputMode,
        CScaleX = combinedScaleX,
        CScaleY = combinedScaleY,
        CScaleZ = combinedScaleZ,
        Seethe = seethe,
        SeetheRate = seetheRate,
        CurrentTime = currentTime,
        Octaves = octaves,
        Lacunarity = lacunarity,
        Persistence = persistence,
        MinValue = minValue,
        MaxValue = maxValue,
    }

    out:MultiProcessPixels(nil, userData, DWleft, DWbottom, width, height, img_temp, processPixel)

    OutImage:Set(req, out)
end
